# ============================================
# VARIABILI D'AMBIENTE - CareScheduler
# ============================================
# 
# COME USARE QUESTO FILE:
# 1. Copia questo file e rinominalo in ".env.local"
# 2. Sostituisci i valori placeholder con le tue chiavi reali
# 3. NON condividere mai il file .env.local (è già nel .gitignore)
#
# DOVE TROVARE LE CHIAVI:
# - VITE_SUPABASE_URL → Supabase Dashboard > Settings (⚙️) > API > Project URL
# - VITE_SUPABASE_ANON_KEY → Supabase Dashboard > Settings (⚙️) > API > anon public
# - RESEND_API_KEY → https://resend.com/api-keys > Create API Key
# - FROM_EMAIL → La tua email verificata su Resend
# - APP_URL → L'URL dove gira la tua app
# ============================================

# ─────────────────────────────────────────────
# SUPABASE (obbligatorio)
# ─────────────────────────────────────────────
VITE_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.INCOLLA_QUI_LA_TUA_CHIAVE_ANON

# ─────────────────────────────────────────────
# RESEND - Per inviare email (opzionale per test)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_INCOLLA_QUI_LA_TUA_CHIAVE_RESEND
FROM_EMAIL=noreply@tuodominio.it

# ─────────────────────────────────────────────
# URL DELL'APP
# ─────────────────────────────────────────────
# In locale: http://localhost:5173
# Su Vercel: https://nome-progetto.vercel.app
APP_URL=http://localhost:5173
